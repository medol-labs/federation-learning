# Copy this file to .env and edit local values as needed.
# Root helper scripts read these values from .env and exported shell variables.

FL_PLATFORM_URL=http://localhost:8081
FL_RUNTIME_AGENT_URL=http://localhost:8082
FL_RUNTIME_ENGINE_URL=http://localhost:18080
FL_API_TOKEN=
FL_CREATE_TRAINING_JOB=true
FL_TRAINING_SCENARIO=densenet
FL_RUNTIME_ENVIRONMENT_TYPE=DOCKER_COMPOSE
FL_RUNTIME_INFRASTRUCTURE_PACKAGE_NAME=Local Docker Compose Runtime
FL_RUNTIME_INFRASTRUCTURE_PACKAGE_VERSION=0.0.1-SNAPSHOT
FL_RUNTIME_AGENT_INSTALL_MODE=MANUAL
FL_RUNTIME_ENDPOINT_SCOPE=LOCAL_DEV
FL_RUNTIME_EXPECTED_NODE_COUNT=1
FL_REGISTER_RUNTIME_INFRASTRUCTURE=true
# Optional local/internal bootstrap token. Prefer FL_API_TOKEN for normal authenticated calls.
MEDOL_SECURITY_INTERNAL_TOKEN=local-dev-internal-token
FL_DEV_DATASET_PATH=../volumes/datasets/test.csv
FL_RUNTIME_DATASET_PATH=/workspace/datasets/test.csv
RUNTIME_AGENT_ID=2336adf7-e0d4-5d84-81f8-86b68248047a
RUNTIME_INFRASTRUCTURE_ID=601bc69e-367c-3a2c-bf1c-e34c4184d350
RUNTIME_AGENT_VERSION=local-medical-dev
RUNTIME_AGENT_ORGANIZATION_ID=cca3332b-052d-5710-a8fe-2ac03911012b
RUNTIME_AGENT_RUNTIME_NAME=local-medical-runtime
RUNTIME_AGENT_ENDPOINT=http://localhost:8082
RUNTIME_AGENT_ENDPOINT_SCOPE=LOCAL_DEV
RUNTIME_AGENT_INSTALL_MODE=MANUAL
RUNTIME_AGENT_CSV_DATASET_LABEL_COLUMNS=readmission_risk
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_NODE_NAME=local-medical-runtime
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_LABEL_COLUMN=readmission_risk
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_ID_COLUMN=id

AXON_API_URL=http://localhost:8080
FEDERATION_LEARNING_SUPPORT_URL=http://localhost:8080
FEDERATION_LEARNING_PLATFORM_URL=http://localhost:8081
FEDERATION_LEARNING_RUNTIME_AGENT_URL=http://localhost:8082

DOCKER_IMAGE_PREFIX=medol
IMAGE_VERSION=0.0.1-SNAPSHOT
IMAGE_TAR=federation-learning-platform-images.tar
DEPENDENCY_IMAGE_TAR=dependency-images.tar
FAST_IMAGE_BUILD=true
MAVEN_OFFLINE=false
# Set only when packaging images for a specific target platform.
# DOCKER_DEFAULT_PLATFORM=linux/arm64

PLATFORM_RUNTIME_DOCKER_COMPOSE_ENABLED=true
PLATFORM_RUNTIME_DOCKER_COMPOSE_FILE=federation-learning-runtime-agent/docker-compose.yml
PLATFORM_RUNTIME_DOCKER_COMPOSE_PROJECT_NAME=
PLATFORM_RUNTIME_DOCKER_COMPOSE_PROJECT_DIRECTORY=.
PLATFORM_RUNTIME_DOCKER_COMPOSE_AGENT_SERVICE_NAME=federation-learning-runtime-agent
PLATFORM_RUNTIME_DOCKER_COMPOSE_AGENT_VERSION=docker-compose
PLATFORM_RUNTIME_DOCKER_COMPOSE_COMMAND_TIMEOUT=PT60S
PLATFORM_RUNTIME_DOCKER_COMPOSE_SUPPORTED_DEPLOYMENT_TARGET_TYPES=DOCKER_COMPOSE_HOST
PLATFORM_RUNTIME_DOCKER_COMPOSE_SUPPORTED_ENVIRONMENT_TYPES=DOCKER_COMPOSE

PLATFORM_RUNTIME_K3S_ENABLED=true
PLATFORM_RUNTIME_K3S_KUBECTL_EXECUTABLE=kubectl
PLATFORM_RUNTIME_K3S_KUBECONFIG=
PLATFORM_RUNTIME_K3S_NAMESPACE=default
PLATFORM_RUNTIME_K3S_AGENT_MANIFEST_FILE=../k3s/runtime-agent.yaml
PLATFORM_RUNTIME_K3S_AGENT_DEPLOYMENT_NAME=federation-learning-runtime-agent
PLATFORM_RUNTIME_K3S_AGENT_VERSION=k3s
PLATFORM_RUNTIME_K3S_COMMAND_TIMEOUT=PT60S
PLATFORM_RUNTIME_K3S_SUPPORTED_DEPLOYMENT_TARGET_TYPES=K3S,K3S_CLUSTER
PLATFORM_RUNTIME_K3S_SUPPORTED_ENVIRONMENT_TYPES=K3S,KUBERNETES

AXON_LOG_LEVEL=INFO
