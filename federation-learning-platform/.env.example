# Copy this file to .env and edit local values as needed.
# Docker Compose reads .env automatically from this directory.

MEDOL_AXON_EVENT_STORAGE=umadb

AXON_SERVER_ENABLED=false
AXON_SERVER_EVENT_STORE_ENABLED=false
AXON_SERVER_HTTP_PORT=8024
AXON_SERVER_GRPC_PORT=8124
AXON_UPDATE_CHECK_DISABLED=true

UMADB_TARGET=localhost:50052
UMADB_PORT=50052
UMADB_PLAINTEXT=true
UMADB_API_KEY=
UMADB_BATCH_SIZE=256
UMADB_REQUEST_TIMEOUT=PT10S

APP_IMAGE=
APP_PORT=8081
RUNTIME_AGENT_URL=
FEDERATION_LEARNING_DICTIONARY_URL=
FEDERATION_LEARNING_RUNTIME_AGENT_URL=

PLATFORM_RUNTIME_DOCKER_COMPOSE_ENABLED=true
PLATFORM_RUNTIME_DOCKER_COMPOSE_FILE=../docker-compose-runtime-agent.yml
PLATFORM_RUNTIME_DOCKER_COMPOSE_PROJECT_NAME=
PLATFORM_RUNTIME_DOCKER_COMPOSE_PROJECT_DIRECTORY=..
PLATFORM_RUNTIME_DOCKER_COMPOSE_AGENT_SERVICE_NAME=federation-learning-runtime-agent
PLATFORM_RUNTIME_DOCKER_COMPOSE_AGENT_VERSION=docker-compose
PLATFORM_RUNTIME_DOCKER_COMPOSE_COMMAND_TIMEOUT=PT60S
PLATFORM_RUNTIME_DOCKER_COMPOSE_SUPPORTED_DEPLOYMENT_TARGET_TYPES=DOCKER_COMPOSE_HOST
PLATFORM_RUNTIME_DOCKER_COMPOSE_SUPPORTED_ENVIRONMENT_TYPES=DOCKER_COMPOSE

PLATFORM_RUNTIME_K3S_ENABLED=true
PLATFORM_RUNTIME_K3S_KUBECTL_EXECUTABLE=kubectl
PLATFORM_RUNTIME_K3S_KUBECONFIG=
PLATFORM_RUNTIME_K3S_NAMESPACE=default
PLATFORM_RUNTIME_K3S_AGENT_MANIFEST_FILE=../k3s/runtime-agent.yaml
PLATFORM_RUNTIME_K3S_AGENT_DEPLOYMENT_NAME=federation-learning-runtime-agent
PLATFORM_RUNTIME_K3S_AGENT_VERSION=k3s
PLATFORM_RUNTIME_K3S_COMMAND_TIMEOUT=PT60S
PLATFORM_RUNTIME_K3S_SUPPORTED_DEPLOYMENT_TARGET_TYPES=K3S,K3S_CLUSTER
PLATFORM_RUNTIME_K3S_SUPPORTED_ENVIRONMENT_TYPES=K3S,KUBERNETES
