# Copy this file to .env and edit local values as needed.
# Docker Compose reads .env automatically from this directory.

MEDOL_AXON_EVENT_STORAGE=umadb
DOCKER_PLATFORM=

MEDOL_SECURITY_ENABLED=true
MEDOL_SECURITY_PROVIDER=local
MEDOL_SECURITY_JWT_SECRET=change-me-change-me-change-me-change-me
MEDOL_SECURITY_LOCAL_TOKEN_TTL_SECONDS=28800
MEDOL_SECURITY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
MEDOL_SECURITY_INTERNAL_TOKEN=local-dev-internal-token
MEDOL_SECURITY_INTERNAL_SUBJECT=00000000-0000-0000-0000-000000000001
MEDOL_SECURITY_INTERNAL_USERNAME=internal-service
MEDOL_SECURITY_INTERNAL_ROLES=SERVICE
MEDOL_SECURITY_INTERNAL_PERMISSIONS=*:*
MEDOL_SECURITY_ADMIN_BOOTSTRAP_ENABLED=false
MEDOL_SECURITY_ADMIN_BOOTSTRAP_SETUP_TOKEN=
SUPABASE_JWT_ISSUER_URI=
SUPABASE_JWT_JWK_SET_URI=

AXON_SERVER_ENABLED=false
AXON_SERVER_EVENT_STORE_ENABLED=false
AXON_SERVER_HTTP_PORT=8024
AXON_SERVER_GRPC_PORT=8124
AXON_UPDATE_CHECK_DISABLED=true

UMADB_TARGET=localhost:50053
APP_UMADB_TARGET=
UMADB_PORT=50053
UMADB_PLAINTEXT=true
UMADB_API_KEY=
UMADB_BATCH_SIZE=256
UMADB_REQUEST_TIMEOUT=PT10S

APP_IMAGE=
APP_PORT=8082
FEDERATION_LEARNING_SUPPORT_URL=http://localhost:8080
FEDERATION_LEARNING_PLATFORM_URL=http://localhost:8081
RUNTIME_AGENT_DATASETS_DIR=../../volumes/datasets

RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_ENABLED=true
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_COMPOSE_FILE=../../federation-learning-runtime-engine/docker-compose.yml
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_PROJECT_NAME=runtime-engine
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_SERVICE_NAME=runtime-engine
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_ENDPOINT=http://localhost:18080
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_NODE_NAME=local-runtime
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_RUNTIME_ROOT=/workspace/tmp/runtime-engine
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_RUNTIME_ROOT_HOST_ROOT=../../volumes/tmp/runtime-engine
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_DATASET_HOST_ROOT=/workspace/datasets
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_DATASET_CONTAINER_ROOT=/workspace/datasets
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_LABEL_COLUMN=readmission_risk
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_ID_COLUMN=id
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_MODEL=linear.LogisticRegression
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_EPOCH=1
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_LEARNING_RATE=0.1
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_COMMAND_TIMEOUT=PT2M
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_HEALTH_TIMEOUT=PT30S
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_HEALTH_POLL_INTERVAL=PT1S
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_JOB_OBSERVATION_TIMEOUT=PT5M
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_JOB_OBSERVATION_POLL_INTERVAL=PT2S
