# Copy this file to .env and edit local values as needed.
# Docker Compose reads .env automatically from this directory.

MEDOL_AXON_EVENT_STORAGE=umadb

AXON_SERVER_ENABLED=false
AXON_SERVER_EVENT_STORE_ENABLED=false
AXON_SERVER_HTTP_PORT=8024
AXON_SERVER_GRPC_PORT=8124
AXON_UPDATE_CHECK_DISABLED=true

UMADB_TARGET=localhost:50053
UMADB_PORT=50053
UMADB_PLAINTEXT=true
UMADB_API_KEY=
UMADB_BATCH_SIZE=256
UMADB_REQUEST_TIMEOUT=PT10S

APP_IMAGE=
APP_PORT=8082
FEDERATION_LEARNING_SUPPORT_URL=
FEDERATION_LEARNING_PLATFORM_URL=

RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_ENABLED=true
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_COMPOSE_FILE=../GemiFL/docker-compose.yml
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_PROJECT_NAME=gemifl-runtime
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_SERVICE_NAME=alice-runtime
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_ENDPOINT=http://localhost:8081
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_NODE_NAME=Alice
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_RUNTIME_ROOT=/workspace/tmp/gemifl
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_DATASET_HOST_ROOT=../volumes/datasets
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_DATASET_CONTAINER_ROOT=/workspace/datasets
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_MODEL=linear.LogisticRegression
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_EPOCH=1
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_LEARNING_RATE=0.1
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_COMMAND_TIMEOUT=PT2M
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_HEALTH_TIMEOUT=PT30S
RUNTIME_AGENT_LOCAL_RUNTIME_ENGINE_HEALTH_POLL_INTERVAL=PT1S
