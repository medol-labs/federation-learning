{
  "schemaVersion": 1,
  "environment": "local",
  "stateFile": "simulation/test-environment.private.json",
  "generate": [
    "database",
    "internalToken",
    "jwt",
    "setupToken",
    "adminPassword"
  ],
  "outputs": [
    {
      "format": "env",
      "path": ".env",
      "template": {
        "MEDOL_IMAGE_SOURCE": "registry",
        "FL_K3D_ADMIN_USERNAME": "simulation-admin",
        "FL_K3D_ADMIN_PASSWORD": {
          "$secret": "adminPassword"
        },
        "FL_K3D_ADMIN_SETUP_TOKEN": {
          "$secret": "setupToken"
        },
        "MEDOL_SECURITY_ADMIN_BOOTSTRAP_SETUP_TOKEN": {
          "$secret": "setupToken"
        },
        "FL_K3D_JWT_SECRET": {
          "$secret": "jwt"
        },
        "MEDOL_SECURITY_JWT_SECRET": {
          "$secret": "jwt"
        },
        "MEDOL_SECURITY_INTERNAL_TOKEN": {
          "$secret": "internalToken"
        },
        "RUNTIME_AGENT_DB_PASSWORD": {
          "$secret": "database"
        }
      }
    },
    {
      "format": "json",
      "path": "operations/k3s/environments/local/secrets.local.yaml",
      "template": {
        "apiVersion": "v1",
        "kind": "List",
        "items": [
          {
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {
              "name": "postgres-secret"
            },
            "type": "Opaque",
            "stringData": {
              "username": "medol",
              "password": {
                "$secret": "database"
              }
            }
          },
          {
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {
              "name": "federation-learning-platform-local-secret"
            },
            "type": "Opaque",
            "stringData": {
              "DB_USERNAME": "medol",
              "DB_PASSWORD": {
                "$secret": "database"
              },
              "MEDOL_SECURITY_INTERNAL_TOKEN": {
                "$secret": "internalToken"
              },
              "MEDOL_SECURITY_JWT_SECRET": {
                "$secret": "jwt"
              },
              "MEDOL_SECURITY_ADMIN_BOOTSTRAP_SETUP_TOKEN": {
                "$secret": "setupToken"
              },
              "UMADB_API_KEY": ""
            }
          },
          {
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {
              "name": "federation-learning-runtime-agent-local-secret"
            },
            "type": "Opaque",
            "stringData": {
              "DB_USERNAME": "medol",
              "DB_PASSWORD": {
                "$secret": "database"
              },
              "MEDOL_SECURITY_INTERNAL_TOKEN": {
                "$secret": "internalToken"
              },
              "MEDOL_SECURITY_JWT_SECRET": {
                "$secret": "jwt"
              },
              "MEDOL_SECURITY_ADMIN_BOOTSTRAP_SETUP_TOKEN": {
                "$secret": "setupToken"
              },
              "UMADB_API_KEY": ""
            }
          },
          {
            "apiVersion": "v1",
            "kind": "Secret",
            "metadata": {
              "name": "federation-learning-support-local-secret"
            },
            "type": "Opaque",
            "stringData": {
              "DB_USERNAME": "medol",
              "DB_PASSWORD": {
                "$secret": "database"
              },
              "MEDOL_SECURITY_INTERNAL_TOKEN": {
                "$secret": "internalToken"
              },
              "MEDOL_SECURITY_JWT_SECRET": {
                "$secret": "jwt"
              },
              "MEDOL_SECURITY_ADMIN_BOOTSTRAP_SETUP_TOKEN": {
                "$secret": "setupToken"
              },
              "UMADB_API_KEY": ""
            }
          }
        ]
      }
    }
  ]
}
