# Generated environment defaults for local.
# Copy values into your operations secret/env store and keep real secrets out of Git.

GATEWAY_PORT=9080
APISIX_IMAGE=apache/apisix:3.13.0-debian
POSTGRES_USER=medol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medol
MEDOL_SECURITY_INTERNAL_TOKEN=
MEDOL_SECURITY_JWT_SECRET=
MEDOL_SECURITY_ADMIN_BOOTSTRAP_ENABLED=false
MEDOL_SECURITY_ADMIN_BOOTSTRAP_SETUP_TOKEN=
# Replace with the browser-facing origin (scheme, host and port; no API path).
MEDOL_SECURITY_ALLOWED_ORIGINS=http://console.example.com:9080
POSTGRES_IMAGE=postgres:16
POSTGRES_PORT=5432
MEDOL_AXON_EVENT_STORAGE=umadb
UMADB_IMAGE=umadb/umadb:0.7.8
UMADB_TARGET=umadb:50051
UMADB_PLAINTEXT=true
UMADB_API_KEY=
UMADB_BATCH_SIZE=256
UMADB_REQUEST_TIMEOUT=PT10S
UMADB_PORT=50051
AXON_SERVER_IMAGE=axoniq/axonserver:2026.0.3-jdk-21
AXON_SERVER_SERVERS=axon-server:8124
AXON_UPDATE_CHECK_DISABLED=true
VITE_SUPABASE_API_KEY=

# Registry deployment example: registry.example.com:5000/<namespace>/federation-learning-console:0.0.1-SNAPSHOT; offline deployments keep the imported tag.
FEDERATION_LEARNING_CONSOLE_IMAGE=fl/federation-learning-console:0.0.1-SNAPSHOT
# Registry deployment example: registry.example.com:5000/<namespace>/federation-learning-platform:0.0.1-SNAPSHOT; offline deployments keep the imported tag.
FEDERATION_LEARNING_PLATFORM_IMAGE=fl/federation-learning-platform:0.0.1-SNAPSHOT
# Registry deployment example: registry.example.com:5000/<namespace>/federation-learning-support:0.0.1-SNAPSHOT; offline deployments keep the imported tag.
FEDERATION_LEARNING_SUPPORT_IMAGE=fl/federation-learning-support:0.0.1-SNAPSHOT
# Required remote endpoint for federation-learning-platform; replace the example host/port, keeping the gateway API path.
FEDERATION_LEARNING_RUNTIME_AGENT_URL=http://participant-gateway.example.com:9080/api/federation-learning-runtime-agent

MONOREPO_ROOT=../..
DOCKER_IMAGE_PREFIX=fl
DEPENDENCY_IMAGE_PREFIX=fl
IMAGE_VERSION=0.0.1-SNAPSHOT
IMAGE_BUNDLE_OUTPUT=.work/image-bundle
IMAGE_BUNDLE_ARCHIVE=.work/image-bundle.tar.gz
DOCKER_DEFAULT_PLATFORM=
EXTRA_DEPENDENCY_IMAGES=
OPERATIONS_NO_FAST_BUILD=false
OPERATIONS_FULL_IMAGE_BUILD=false

HARBOR_INSTALLER=
ZOT_IMAGE=ghcr.io/project-zot/zot-linux-amd64:v2.1.8
ZOT_HTTP_PORT=5000
