# Copy to runtime-agent.local.env; use actual IDs registered on the platform.
RUNTIME_AGENT_ID=
RUNTIME_AGENT_ORGANIZATION_ID=

# Platform read models and support dictionaries have different sources.
MEDOL_SYNC_ENABLED=true
MEDOL_SYNC_SOURCE_BASE_URL=http://localhost:8081
MEDOL_SYNC_SOURCE_BASE_URLS_DATASETGOVERNANCE=http://localhost:8081
MEDOL_SYNC_SOURCE_BASE_URLS_ORGANIZATIONMANAGEMENT=http://localhost:8081
MEDOL_SYNC_SOURCE_BASE_URLS_RUNTIMEGOVERNANCE=http://localhost:8081
MEDOL_SYNC_SOURCE_BASE_URLS_DICTIONARYMAINTENANCE=http://localhost:8080
