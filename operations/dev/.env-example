# Generated environment defaults for dev.
# Copy values into your operations secret/env store and keep real secrets out of Git.

GATEWAY_PORT=9080
APISIX_IMAGE=apache/apisix:3.13.0-debian
APISIX_CONTAINER_NAME=apisix
POSTGRES_USER=medol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medol
POSTGRES_IMAGE=postgres:16
POSTGRES_PORT=5432
MEDOL_AXON_EVENT_STORAGE=umadb
UMADB_IMAGE=umadb/umadb:0.7.8
UMADB_TARGET=umadb:50051
UMADB_PLAINTEXT=true
UMADB_API_KEY=
UMADB_BATCH_SIZE=256
UMADB_REQUEST_TIMEOUT=PT10S
UMADB_PORT=50051
AXON_SERVER_IMAGE=axoniq/axonserver:2026.0.3-jdk-21
AXON_SERVER_SERVERS=axon-server:8124
AXON_UPDATE_CHECK_DISABLED=true
VITE_SUPABASE_API_KEY=

FEDERATION_LEARNING_CONSOLE_IMAGE=medol/federation-learning-console:0.0.1-SNAPSHOT
FEDERATION_LEARNING_CONSOLE_CONTAINER_NAME=federation-learning-console
FEDERATION_LEARNING_PARTICIPANT_CONSOLE_IMAGE=medol/federation-learning-participant-console:0.0.1-SNAPSHOT
FEDERATION_LEARNING_PARTICIPANT_CONSOLE_CONTAINER_NAME=federation-learning-participant-console
FEDERATION_LEARNING_SUPPORT_IMAGE=medol/federation-learning-support:0.0.1-SNAPSHOT
FEDERATION_LEARNING_SUPPORT_CONTAINER_NAME=federation-learning-support
FEDERATION_LEARNING_SUPPORT_PORT=8080
FEDERATION_LEARNING_PLATFORM_IMAGE=medol/federation-learning-platform:0.0.1-SNAPSHOT
FEDERATION_LEARNING_PLATFORM_CONTAINER_NAME=federation-learning-platform
FEDERATION_LEARNING_PLATFORM_PORT=8081
FEDERATION_LEARNING_RUNTIME_AGENT_IMAGE=medol/federation-learning-runtime-agent:0.0.1-SNAPSHOT
FEDERATION_LEARNING_RUNTIME_AGENT_CONTAINER_NAME=federation-learning-runtime-agent
FEDERATION_LEARNING_RUNTIME_AGENT_PORT=8082

MONOREPO_ROOT=../..
DOCKER_IMAGE_PREFIX=192.168.139.3:5000/fl
DEPENDENCY_IMAGE_PREFIX=192.168.139.3:5000/fl
IMAGE_VERSION=0.0.1-SNAPSHOT
IMAGE_BUNDLE_OUTPUT=.work/image-bundle
IMAGE_BUNDLE_ARCHIVE=.work/image-bundle.tar.gz
DOCKER_DEFAULT_PLATFORM=
EXTRA_DEPENDENCY_IMAGES=
OPERATIONS_NO_FAST_BUILD=false
OPERATIONS_FULL_IMAGE_BUILD=false

HARBOR_INSTALLER=
ZOT_IMAGE=ghcr.io/project-zot/zot-linux-amd64:v2.1.8
ZOT_HTTP_PORT=5000
