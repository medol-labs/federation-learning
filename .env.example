# Copy this file to .env and edit local values as needed.
# Docker Compose reads .env automatically from this directory.

MEDOL_AXON_EVENT_STORAGE=umadb

AXON_SERVER_ENABLED=false
AXON_SERVER_EVENT_STORE_ENABLED=false
AXON_SERVER_HTTP_PORT=8024
AXON_SERVER_GRPC_PORT=8124
AXON_UPDATE_CHECK_DISABLED=true

UMADB_TARGET=localhost:50051
UMADB_PLAINTEXT=true
UMADB_API_KEY=
UMADB_BATCH_SIZE=256
UMADB_REQUEST_TIMEOUT=PT10S

PLATFORM_RUNTIME_DOCKER_COMPOSE_COMPOSE_FILE=../docker-compose-runtime-agent.yml
PLATFORM_RUNTIME_DOCKER_COMPOSE_PROJECT_NAME=federation-learning-runtime-agent
PLATFORM_RUNTIME_DOCKER_COMPOSE_AGENT_SERVICE_NAME=federation-learning-runtime-agent
FEDERATION_LEARNING_RUNTIME_AGENT_IMAGE=medol/federation-learning-runtime-agent:0.0.1-SNAPSHOT
FEDERATION_LEARNING_RUNTIME_AGENT_PORT=8082
RUNTIME_AGENT_AXON_EVENT_STORAGE=inmemory
RUNTIME_AGENT_UMADB_PORT=50052
RUNTIME_AGENT_UMADB_TARGET=runtime-agent-umadb:50051

AXON_LOG_LEVEL=INFO
