{
  "schemaVersion": 2,
  "cases": [
    {
      "id": "system-notification-publish-and-read",
      "title": "Published notification appears unread and single acknowledgement updates catalog and summary",
      "origin": "manual",
      "status": "draft",
      "tags": [
        "system-notification",
        "smoke"
      ],
      "suites": [
        "support"
      ],
      "prerequisites": [
        "Ready support deployment with notification commands and projections",
        "FL_API_TOKEN grants notification publish, acknowledge and query permissions"
      ],
      "dataRequirements": [],
      "steps": [
        {
          "id": "publish",
          "type": "command",
          "command": "PublishSystemNotification",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/publishsystemnotification",
            "body": {
              "notificationId": {
                "$uuid": true
              },
              "publishedAt": {
                "$now": "localDateTime"
              },
              "category": "SYSTEM",
              "severity": "ERROR",
              "messageKey": "simulation.notification.test",
              "fallbackTitle": "Simulation notification",
              "fallbackBody": "Notification lifecycle verification",
              "toastPolicy": "IMPORTANT",
              "status": "UNREAD",
              "recipientUserId": {
                "$ref": "variables.owner"
              }
            }
          }
        },
        {
          "id": "unread",
          "type": "query",
          "query": "SystemNotificationCatalog",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/systemnotificationcatalog",
            "query": {
              "page": 0,
              "size": 20,
              "recipientUserId.equals": {
                "$ref": "variables.owner"
              }
            },
            "expect": {
              "page.totalElements": 1,
              "content.0.state": "Unread"
            }
          }
        },
        {
          "id": "summary-unread",
          "type": "query",
          "query": "SystemNotificationSummary",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/systemnotificationsummary",
            "query": {
              "page": 0,
              "size": 20,
              "recipientUserId.equals": {
                "$ref": "variables.owner"
              }
            },
            "expect": {
              "content.0.unreadCount": 1,
              "content.0.hasUnreadError": true
            }
          }
        },
        {
          "id": "read",
          "type": "command",
          "command": "MarkSystemNotificationRead",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/marksystemnotificationread",
            "body": {
              "readAt": {
                "$now": "localDateTime"
              },
              "notificationId": {
                "$ref": "steps.publish.body.notificationId"
              },
              "recipientUserId": {
                "$ref": "steps.publish.body.recipientUserId"
              }
            }
          }
        },
        {
          "id": "read-catalog",
          "type": "query",
          "query": "SystemNotificationCatalog",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/systemnotificationcatalog",
            "query": {
              "page": 0,
              "size": 20,
              "recipientUserId.equals": {
                "$ref": "variables.owner"
              }
            },
            "expect": {
              "page.totalElements": 1,
              "content.0.state": "Read"
            }
          }
        },
        {
          "id": "summary-read",
          "type": "query",
          "query": "SystemNotificationSummary",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/systemnotificationsummary",
            "query": {
              "page": 0,
              "size": 20,
              "recipientUserId.equals": {
                "$ref": "variables.owner"
              }
            },
            "expect": {
              "content.0.unreadCount": 0,
              "content.0.hasUnreadError": false
            }
          }
        }
      ],
      "assertions": [
        {
          "type": "query",
          "stepId": "unread",
          "path": "content.0.notificationId",
          "operator": "equals",
          "expected": {
            "$ref": "steps.publish.body.notificationId"
          }
        },
        {
          "type": "query",
          "stepId": "unread",
          "path": "content.0.fallbackTitle",
          "operator": "equals",
          "expected": "Simulation notification"
        },
        {
          "type": "query",
          "stepId": "summary-unread",
          "path": "content.0.unreadCount",
          "operator": "equals",
          "expected": 1
        },
        {
          "type": "query",
          "stepId": "read-catalog",
          "path": "content.0.readAt",
          "operator": "exists"
        },
        {
          "type": "query",
          "stepId": "read-catalog",
          "path": "content.0.state",
          "operator": "equals",
          "expected": "Read"
        },
        {
          "type": "query",
          "stepId": "summary-read",
          "path": "content.0.unreadCount",
          "operator": "equals",
          "expected": 0
        }
      ],
      "timeoutMs": 180000,
      "cleanupPolicy": "retain",
      "reviewIssues": [],
      "variables": {
        "owner": {
          "$uuid": true
        },
        "other": {
          "$uuid": true
        }
      }
    },
    {
      "id": "system-notification-filter-and-pagination",
      "title": "Recipient, category, severity and state criteria filter the catalog and preserve total count",
      "origin": "manual",
      "status": "draft",
      "tags": [
        "system-notification",
        "query"
      ],
      "suites": [
        "support"
      ],
      "prerequisites": [
        "Ready support deployment and authorized FL_API_TOKEN"
      ],
      "dataRequirements": [],
      "steps": [
        {
          "id": "info",
          "type": "command",
          "command": "PublishSystemNotification",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/publishsystemnotification",
            "body": {
              "notificationId": {
                "$uuid": true
              },
              "publishedAt": {
                "$now": "localDateTime"
              },
              "category": "SYSTEM",
              "severity": "INFO",
              "messageKey": "simulation.notification.info",
              "fallbackTitle": "Information",
              "toastPolicy": "NONE",
              "status": "UNREAD",
              "recipientUserId": {
                "$ref": "variables.owner"
              }
            }
          }
        },
        {
          "id": "error",
          "type": "command",
          "command": "PublishSystemNotification",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/publishsystemnotification",
            "body": {
              "notificationId": {
                "$uuid": true
              },
              "publishedAt": {
                "$now": "localDateTime"
              },
              "category": "SECURITY",
              "severity": "ERROR",
              "messageKey": "simulation.notification.error",
              "fallbackTitle": "Security error",
              "toastPolicy": "IMPORTANT",
              "status": "UNREAD",
              "recipientUserId": {
                "$ref": "variables.owner"
              }
            }
          }
        },
        {
          "id": "other",
          "type": "command",
          "command": "PublishSystemNotification",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/publishsystemnotification",
            "body": {
              "notificationId": {
                "$uuid": true
              },
              "publishedAt": {
                "$now": "localDateTime"
              },
              "category": "SECURITY",
              "severity": "ERROR",
              "messageKey": "simulation.notification.other",
              "fallbackTitle": "Other recipient",
              "toastPolicy": "NONE",
              "status": "UNREAD",
              "recipientUserId": {
                "$ref": "variables.other"
              }
            }
          }
        },
        {
          "id": "page",
          "type": "query",
          "query": "SystemNotificationCatalog",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/systemnotificationcatalog",
            "query": {
              "page": 0,
              "size": "1",
              "sort": "notificationId,asc",
              "recipientUserId.equals": {
                "$ref": "variables.owner"
              }
            },
            "expect": {
              "page.totalElements": 2,
              "content.length": 1,
              "page.totalPages": 2
            }
          }
        },
        {
          "id": "page-two",
          "type": "query",
          "query": "SystemNotificationCatalog",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/systemnotificationcatalog",
            "query": {
              "page": "1",
              "size": "1",
              "sort": "notificationId,asc",
              "recipientUserId.equals": {
                "$ref": "variables.owner"
              }
            },
            "expect": {
              "page.totalElements": 2,
              "content.length": 1,
              "page.number": 1
            }
          }
        },
        {
          "id": "filtered",
          "type": "query",
          "query": "SystemNotificationCatalog",
          "request": {
            "endpoint": "support",
            "path": "/systemnotification/systemnotificationcatalog",
            "query": {
              "page": 0,
              "size": 20,
              "category.equals": "SECURITY",
              "severity.equals": "ERROR",
              "state.equals": "Unread",
              "recipientUserId.equals": {
                "$ref": "variables.owner"
              }
            },
            "expect": {
              "page.totalElements": 1
            }
          }
        }
      ],
      "assertions": [
        {
          "type": "query",
          "stepId": "page",
          "path": "page.totalElements",
          "operator": "equals",
          "expected": 2
        },
        {
          "type": "query",
          "stepId": "page-two",
          "path": "page.number",
          "operator": "equals",
          "expected": 1
        },
        {
          "type": "query",
          "stepId": "filtered",
          "path": "content.0.notificationId",
          "operator": "equals",
          "expected": {
            "$ref": "steps.error.body.notificationId"
          }
        }
      ],
      "timeoutMs": 180000,
      "cleanupPolicy": "retain",
      "reviewIssues": [],
      "variables": {
        "owner": {
          "$uuid": true
        },
        "other": {
          "$uuid": true
        }
      }
    },
