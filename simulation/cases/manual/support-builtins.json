        }
      ]
    },
    {
      "id": "support-invalid-import",
      "title": "Reject an import request with an inconsistent initial status",
      "origin": "model",
      "sourceScenarioId": "reject-inconsistent-status",
      "sourceFingerprint": "113ea2ffe74fec2fdcaf7189a19da389c40f06b0d2c4e0a7e1c99f1ce5c24e8b",
      "tags": [
        "support-builtins",
        "invalid-import"
      ],
      "suites": [
        "support"
      ],
      "status": "draft",
      "variables": {
        "id": {
          "$uuid": true
        },
        "key": {
          "$uuid": true
        }
      },
      "prerequisites": [
        "Authenticated Support API on a ready deployment"
      ],
      "dataRequirements": [],
      "steps": [
        {
          "id": "invalid",
          "type": "command",
          "command": "RequestDataImport",
          "request": {
            "endpoint": "support",
            "path": "/dataimportjob/requestdataimport",
            "body": {
              "dataImportJobId": {
                "$ref": "variables.id"
              },
              "commandName": "SimulationFixture",
              "resourceName": "simulation",
              "originalFileName": "fixture.csv",
              "filePath": "simulation-fixture.csv",
              "requestedAt": {
                "$now": "localDateTime"
              },
              "requestHash": {
                "$ref": "variables.key"
              },
              "status": "INVALID"
            },
            "acceptStatuses": [
              422
            ]
          }
        },
        {
          "id": "absent",
          "type": "query",
          "query": "DataImportJobCatalog",
          "request": {
            "endpoint": "support",
            "path": "/dataimportjob/dataimportjobcatalog",
            "query": {
              "dataImportJobId.equals": {
                "$ref": "variables.id"
              }
            },
            "expect": {
              "page.totalElements": 0
            }
          }
        }
      ],
      "assertions": [
        {
          "type": "query",
          "stepId": "invalid",
          "path": "detail",
          "operator": "equals",
          "expected": "Status does not match the operation."
        },
        {
          "type": "query",
          "stepId": "absent",
          "path": "page.totalElements",
          "operator": "equals",
          "expected": 0
        }
      ],
      "timeoutMs": 120000,
      "cleanupPolicy": "retain",
      "reviewIssues": [],
      "environmentRequirements": [
        {
          "path": "endpoints.support"
        }
      ]
    }
  ]
