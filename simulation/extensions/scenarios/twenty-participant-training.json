{
  "fixtures": [
    {
      "id": "training-dataset",
      "source": "simulation/extensions/fixtures/test.csv",
      "sha256": "b1c3c46512ce01f2c3b8ba7f614c642e6a33546168d309914a6ff77d1b93736e",
      "localPath": "volumes/datasets/test.csv",
      "destinations": [
        {
          "transport": "k3d-node-file",
          "nodeSelector": "!node-role.kubernetes.io/control-plane,!node-role.kubernetes.io/master",
          "path": "/workspace/datasets/test.csv"
        }
      ]
    }
  ],
  "dataRequirements": {
    "participants": [
      "prepare-participants",
      "check-participants"
    ],
    "csv": [
      "prepare-participants",
      "check-participants"
    ]
  },
  "dataPlan": {
    "steps": [
      {
        "id": "prepare-participants",
        "kind": "command",
        "operation": "PrepareParticipants",
        "timeoutMs": 14400000
      },
      {
        "id": "check-participants",
        "kind": "wait",
        "operation": "CheckParticipantData",
        "expect": {
          "path": "ready",
          "equals": true
        }
      }
    ],
    "exports": {
      "$ref": "steps.check-participants.response.snapshot"
    }
  },
  "arguments": [
    "--environment",
    "local",
    "--scenario",
    "csv",
    "--participant-count",
    "20",
    "--federation-mode",
    "global",
    "--recreate",
    "false",
    "--rebuild-app-images",
    "false",
    "--sync-default-kubeconfig",
    "false",
    "--wait-for-training",
    "--timeout",
    "1800000",
    "--max-rounds",
    "2"
  ],
  "steps": [
    {
      "id": "cluster",
      "action": "prepareCluster"
    },
    {
      "id": "images",
      "action": "prepareImages"
    },
    {
      "id": "deployment",
      "action": "deploy"
    },
    {
      "id": "readiness",
      "action": "waitReady"
    },
    {
      "id": "authentication-and-dictionaries",
      "action": "bootstrap"
    },
    {
      "id": "participants",
      "action": "prepareParticipant",
      "repeat": "participantCount"
    },
    {
      "id": "training-submission",
      "action": "submitTraining"
    },
    {
      "id": "training-verification",
      "action": "verifyTraining"
    }
  ]
}
