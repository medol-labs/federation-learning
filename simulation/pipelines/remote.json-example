{
  "hosts": {
    "k3d": {
      "transport": "ssh",
      "target": "fl-test",
      "workDir": "/home/fl-simulation/test"
    }
  },
  "steps": [
    {
      "id": "sync",
      "phase": "environment",
      "command": [
        "node",
        "simulation/src/worker.mjs",
        "sync",
        "simulation/pipelines/worker.json"
      ]
    },
    {
      "id": "environment",
      "phase": "environment",
      "host": "k3d",
      "dependsOn": [
        "sync"
      ],
      "timeoutMs": 600000,
      "command": [
        "node",
        "simulation/src/prepare-environment.mjs",
        "simulation/pipelines/environment-isolated.json"
      ]
    },
    {
      "id": "build",
      "phase": "build",
      "timeoutMs": 7200000,
      "command": [
        "node",
        "operations/images/images.mjs",
        "build",
        "--environment",
        "local",
        "--platform",
        "linux/arm64",
        "--version",
        "simulation-20261116"
      ]
    },
    {
      "id": "publish",
      "phase": "publish",
      "dependsOn": [
        "build"
      ],
      "timeoutMs": 7200000,
      "command": [
        "node",
        "operations/images/images.mjs",
        "push",
        "--environment",
        "local",
        "--platform",
        "linux/arm64",
        "--version",
        "simulation-20261116",
        "--push-prefix",
        "192.168.50.2:5000/fl"
      ]
    },
    {
      "id": "build-engine",
      "phase": "build",
      "timeoutMs": 7200000,
      "command": [
        "node",
        "federation-learning-runtime-engine/scripts/image-bundle.mjs",
        "build",
        "--root",
        "federation-learning-runtime-engine",
        "--platform",
        "linux/arm64",
        "--version",
        "simulation-20261116",
        "--plugin-profile",
        "pytorch-vision",
        "--base-image",
        "public.ecr.aws/docker/library/python:3.11-slim"
      ]
    },
    {
      "id": "publish-engine",
      "phase": "publish",
      "dependsOn": [
        "build-engine"
      ],
      "timeoutMs": 7200000,
      "command": [
        "node",
        "federation-learning-runtime-engine/scripts/image-bundle.mjs",
        "push",
        "--root",
        "federation-learning-runtime-engine",
        "--platform",
        "linux/arm64",
        "--version",
        "simulation-20261116",
        "--plugin-profile",
        "pytorch-vision",
        "--push-prefix",
        "192.168.50.2:5000/fl"
      ]
    },
    {
      "id": "build-engine-sklearn",
      "phase": "build",
      "timeoutMs": 7200000,
      "command": [
        "node",
        "federation-learning-runtime-engine/scripts/image-bundle.mjs",
        "build",
        "--root",
        "federation-learning-runtime-engine",
        "--platform",
        "linux/arm64",
        "--version",
        "simulation-20261116",
        "--plugin-profile",
        "sklearn",
        "--base-image",
        "public.ecr.aws/docker/library/python:3.11-slim"
      ]
    },
    {
      "id": "publish-engine-sklearn",
      "phase": "publish",
      "dependsOn": [
        "build-engine-sklearn"
      ],
      "timeoutMs": 7200000,
      "command": [
        "node",
        "federation-learning-runtime-engine/scripts/image-bundle.mjs",
        "push",
        "--root",
        "federation-learning-runtime-engine",
        "--platform",
        "linux/arm64",
        "--version",
        "simulation-20261116",
        "--plugin-profile",
        "sklearn",
        "--push-prefix",
        "192.168.50.2:5000/fl"
      ]
    },
    {
      "id": "secrets",
      "phase": "deployment",
      "host": "k3d",
      "dependsOn": [
        "environment",
        "publish",
        "publish-engine",
        "publish-engine-sklearn"
      ],
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "secrets"
      ]
    },
    {
      "id": "deploy",
      "phase": "deployment",
      "host": "k3d",
      "dependsOn": [
        "secrets"
      ],
      "timeoutMs": 1800000,
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "deploy"
      ]
    },
    {
      "id": "review-cases",
      "phase": "case-design",
      "host": "k3d",
      "dependsOn": [
        "sync"
      ],
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "select-cases"
      ]
    },
    {
      "id": "prepare-baseline",
      "phase": "data-preparation",
      "host": "k3d",
      "dependsOn": [
        "deploy"
      ],
      "timeoutMs": 7200000,
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "prepare-baseline"
      ]
    },
    {
      "id": "prepare-case",
      "phase": "data-preparation",
      "host": "k3d",
      "dependsOn": [
        "prepare-baseline",
        "review-cases"
      ],
      "timeoutMs": 7200000,
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "prepare-case"
      ]
    },
    {
      "id": "execute-cases",
      "phase": "test-execution",
      "host": "k3d",
      "dependsOn": [
        "prepare-case",
        "review-cases"
      ],
      "timeoutMs": 7200000,
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "test"
      ]
    },
    {
      "id": "collect",
      "phase": "reporting",
      "dependsOn": [
        "execute-cases"
      ],
      "command": [
        "node",
        "simulation/src/worker.mjs",
        "collect",
        "simulation/pipelines/worker.json"
      ]
    }
  ]
}
