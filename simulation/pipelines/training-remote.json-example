{
  "hosts": {
    "worker": {
      "transport": "ssh",
      "target": "fl-test",
      "workDir": "/home/fl-simulation/test"
    }
  },
  "existingEnvironment": {
    "manifest": "simulation/instances/remote.json",
    "remoteManifestPaths": {
      "worker": "/home/fl-simulation/test/simulation/instances/remote.json"
    }
  },
  "steps": [
    {
      "id": "review-cases",
      "phase": "case-design",
      "host": "worker",
      "command": [
        "node",
        "simulation/src/cases.mjs",
        "check",
        "simulation/cases/approved/training.json"
      ]
    },
    {
      "id": "prepare-baseline",
      "phase": "data-preparation",
      "host": "worker",
      "timeoutMs": 7200000,
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "prepare-baseline"
      ],
      "dependsOn": []
    },
    {
      "id": "prepare-case",
      "phase": "data-preparation",
      "host": "worker",
      "timeoutMs": 7200000,
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "prepare-case"
      ],
      "dependsOn": [
        "prepare-baseline",
        "review-cases"
      ]
    },
    {
      "id": "execute-cases",
      "phase": "test-execution",
      "host": "worker",
      "timeoutMs": 7200000,
      "dependsOn": [
        "review-cases",
        "prepare-case"
      ],
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "test"
      ]
    }
  ]
}
