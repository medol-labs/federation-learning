{
  "existingEnvironment": {
    "manifest": "simulation/instances/local.json"
  },
  "steps": [
    {
      "id": "review-cases",
      "phase": "case-design",
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "select-cases"
      ]
    },
    {
      "id": "prepare-baseline",
      "phase": "data-preparation",
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "prepare-baseline"
      ]
    },
    {
      "id": "prepare-case",
      "phase": "data-preparation",
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "prepare-case"
      ],
      "dependsOn": [
        "prepare-baseline",
        "review-cases"
      ]
    },
    {
      "id": "execute-cases",
      "phase": "test-execution",
      "dependsOn": [
        "review-cases",
        "prepare-case"
      ],
      "timeoutMs": 7200000,
      "command": [
        "node",
        "simulation/src/task.mjs",
        "simulation/pipelines/tasks.json",
        "test"
      ]
    }
  ]
}
