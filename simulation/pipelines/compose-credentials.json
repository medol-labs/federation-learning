{
  "schemaVersion": 1,
  "environment": "local",
  "stateFile": "simulation/compose/credentials.private.json",
  "generate": [
    "database",
    "internalToken",
    "jwt",
    "setupToken",
    "adminPassword"
  ],
  "outputs": [
    {
      "format": "env",
      "path": "simulation/compose/.env",
      "template": {
        "POSTGRES_PASSWORD": {
          "$secret": "database"
        },
        "MEDOL_SECURITY_INTERNAL_TOKEN": {
          "$secret": "internalToken"
        },
        "MEDOL_SECURITY_JWT_SECRET": {
          "$secret": "jwt"
        },
        "MEDOL_SECURITY_ADMIN_BOOTSTRAP_SETUP_TOKEN": {
          "$secret": "setupToken"
        },
        "FL_K3D_ADMIN_USERNAME": "simulation-admin",
        "FL_K3D_ADMIN_PASSWORD": {
          "$secret": "adminPassword"
        },
        "FL_K3D_ADMIN_SETUP_TOKEN": {
          "$secret": "setupToken"
        },
        "PUBLIC_SUPPORT_URL": "http://192.168.1.4:28080"
      }
    }
  ]
}
