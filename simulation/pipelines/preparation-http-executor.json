{
  "envFile": ".env",
  "endpoints": {
    "support-user": {
      "environmentEndpoint": "support",
      "anonymous": true
    },
    "platform-user": {
      "environmentEndpoint": "platform",
      "anonymous": true
    },
    "participant-user": {
      "collection": "participantDeployments",
      "key": "slot",
      "urlField": "consoleUrl",
      "suffix": "/api/federation-learning-runtime-agent",
      "anonymous": true
    }
  },
  "probes": [
    {
      "endpoint": "support-user",
      "path": "/actuator/health",
      "expect": {
        "status": "UP"
      }
    },
    {
      "endpoint": "platform-user",
      "path": "/actuator/health",
      "expect": {
        "status": "UP"
      }
    }
  ]
}
