{
  "existingEnvironment": {"manifest": "simulation/instances/local.json"},
  "steps": [
    {
      "id": "review-cases", "phase": "case-design",
      "command": ["node", "simulation/src/cases.mjs", "check", "simulation/cases/approved-training.json"]
    },
    {
      "id": "prepare-data", "phase": "data-preparation",
      "command": ["node", "simulation/extensions/runtime/training-stages.mjs", "prepare", "simulation/instances/local.json", "simulation/extensions/scenarios/two-participant-training.json", "simulation/data/participants.json"]
    },
    {
      "id": "execute-cases", "phase": "test-execution", "dependsOn": ["review-cases", "prepare-data"],
      "command": ["node", "simulation/extensions/runtime/training-stages.mjs", "test", "simulation/instances/local.json", "simulation/extensions/scenarios/two-participant-training.json", "simulation/data/participants.json", "simulation/cases/approved-training.json", "simulation/reports/training-cases.json"]
    }
  ]
}
