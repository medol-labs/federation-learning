{
  "tasks": {
    "select-cases": {
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "select",
      "inputs": {
        "library": {
          "path": "simulation/cases/catalog.json"
        },
        "environment": {"artifact": "deployment.json", "env": "MEDOL_ENVIRONMENT_MANIFEST", "status": "ready", "binding": "deployment"},
        "selection": {
          "path": "simulation/pipelines/case-selection.json",
          "env": "MEDOL_CASE_SELECTION"
        }
      },
      "successStatuses": [
        "ready"
      ],
      "output": "execution-plan.json",
      "scope": "execution"
    },
    "secrets": {
      "module": "simulation/extensions/adapters/workflow-operations.mjs",
      "export": "configureTestEnvironment",
      "inputs": {
        "config": {
          "path": "operations/extensions/test-credentials.json"
        }
      },
      "output": "test-configuration.json",
      "scope": "deployment"
    },
    "deploy": {
      "module": "simulation/extensions/adapters/workflow-operations.mjs",
      "export": "deploy",
      "inputs": {
        "config": {
          "path": "simulation/pipelines/deployment.json-example",
          "env": "MEDOL_DEPLOYMENT_CONFIG"
        },
        "catalog": {
          "path": "operations/model/services.json"
        }
      },
      "output": "deployment.json",
      "scope": "deployment"
    },
    "prepare-baseline": {
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "prepareWorkflow",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "status": "ready",
          "binding": "deployment"
        },
        "workflow": {
          "path": "simulation/cases/approved/baseline-workflow-v2.json"
        },
        "inputs": {
          "path": "dictionary-init/dictionaries.json"
        },
        "config": {
          "path": "simulation/pipelines/preparation-http-executor.json"
        }
      },
      "output": "baseline.json",
      "scope": "execution"
    },
    "enroll-participants": {
      "module": "simulation/extensions/adapters/workflow-operations.mjs",
      "export": "enroll",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "status": "ready",
          "binding": "deployment"
        },
        "baseline": {
          "artifact": "baseline.json",
          "env": "MEDOL_BASELINE_DATA_MANIFEST",
          "status": "ready",
          "binding": "baseline"
        },
        "scenario": {
          "path": "simulation/extensions/scenarios/two-participant-training.json"
        }
      },
      "output": "enrollment.json",
      "scope": "execution"
    },
    "prepare-case": {
      "module": "simulation/extensions/adapters/workflow-operations.mjs",
      "export": "prepare",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "status": "ready",
          "binding": "deployment"
        },
        "baseline": {
          "artifact": "baseline.json",
          "env": "MEDOL_BASELINE_DATA_MANIFEST",
          "status": "ready",
          "binding": "baseline"
        },
        "fixtureScenarios": {"path": "simulation/extensions/scenarios/training-fixtures.json"},
        "cases": {
          "artifact": "execution-plan.json",
          "env": "MEDOL_EXECUTION_PLAN",
          "binding": "plan"
        }
      },
      "output": "data.json",
      "scope": "execution"
    },
    "test": {
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "test",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "status": "ready",
          "binding": "deployment"
        },
        "data": {
          "artifact": "data.json",
          "env": "MEDOL_DATA_MANIFEST",
          "status": "ready",
          "binding": "data"
        },
        "cases": {
          "artifact": "execution-plan.json",
          "env": "MEDOL_EXECUTION_PLAN",
          "binding": "plan"
        },
        "config": {
          "path": "simulation/pipelines/http-executor.json"
        }
      },
      "output": "test.json",
      "scope": "execution"
    },
    "prepare-participant-auth": {
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "prepareWorkflow",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "status": "ready",
          "binding": "deployment"
        },
        "workflow": {
          "path": "simulation/cases/approved/participant-auth-workflow-v2.json"
        },
        "config": {
          "path": "simulation/pipelines/preparation-http-executor.json"
        }
      },
      "output": "participant-auth.json",
      "scope": "execution"
    }
  }
}
