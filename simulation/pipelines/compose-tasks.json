{
  "tasks": {
    "secrets": {
      "scope": "deployment",
      "module": "simulation/extensions/adapters/compose-training.mjs",
      "export": "secrets",
      "inputs": {
        "config": {
          "path": "simulation/pipelines/compose-credentials.json"
        }
      },
      "output": "credentials.json"
    },
    "deploy": {
      "scope": "deployment",
      "module": "simulation/extensions/adapters/compose-training.mjs",
      "export": "deploy",
      "inputs": {
        "config": {
          "path": "simulation/pipelines/compose-deployment.json",
          "env": "MEDOL_DEPLOYMENT_CONFIG"
        }
      },
      "output": "deployment.json"
    },
    "select-cases": {
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "select",
      "inputs": {
        "library": {
          "path": "simulation/cases/catalog.json"
        },
        "environment": {"artifact": "deployment.json", "env": "MEDOL_ENVIRONMENT_MANIFEST", "status": "ready", "binding": "deployment"},
        "selection": {
          "path": "simulation/pipelines/case-selection.json",
          "env": "MEDOL_CASE_SELECTION"
        }
      },
      "successStatuses": [
        "ready"
      ],
      "output": "execution-plan.json",
      "scope": "execution"
    },
    "prepare-baseline": {
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "prepareWorkflow",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "status": "ready",
          "binding": "deployment"
        },
        "workflow": {
          "path": "simulation/cases/approved/baseline-workflow-v2.json"
        },
        "inputs": {
          "path": "dictionary-init/dictionaries.json"
        },
        "config": {
          "path": "simulation/pipelines/compose-preparation-http-executor.json"
        }
      },
      "output": "baseline.json",
      "scope": "execution"
    },
    "prepare-case": {
      "scope": "execution",
      "module": "simulation/extensions/adapters/compose-training.mjs",
      "export": "prepare",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "binding": "deployment"
        },
        "baseline": {
          "artifact": "baseline.json",
          "env": "MEDOL_BASELINE_DATA_MANIFEST",
          "binding": "baseline"
        },
        "cases": {
          "artifact": "execution-plan.json",
          "binding": "plan"
        }
      },
      "output": "data.json"
    },
    "test": {
      "scope": "execution",
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "test",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "binding": "deployment"
        },
        "data": {
          "artifact": "data.json",
          "env": "MEDOL_DATA_MANIFEST",
          "binding": "data"
        },
        "cases": {
          "artifact": "execution-plan.json",
          "binding": "plan"
        },
        "config": {
          "path": "simulation/pipelines/compose-http-executor.json"
        }
      },
      "output": "test.json"
    },
    "prepare-participant-auth": {
      "module": "simulation/src/workflow-tasks.mjs",
      "export": "prepareWorkflow",
      "inputs": {
        "environment": {
          "artifact": "deployment.json",
          "env": "MEDOL_ENVIRONMENT_MANIFEST",
          "status": "ready",
          "binding": "deployment"
        },
        "workflow": {
          "path": "simulation/cases/approved/participant-auth-workflow-v2.json"
        },
        "config": {
          "path": "simulation/pipelines/compose-preparation-http-executor.json"
        }
      },
      "output": "participant-auth.json",
      "scope": "execution"
    }
  }
}
